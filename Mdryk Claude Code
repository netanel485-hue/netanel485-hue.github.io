<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<title>מדריך Claude Code — מתחילים בלי לדעת לתכנת</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#faf7f2; --bg2:#f3ede4; --surface:#ffffff; --surface2:#fffbf6;
  --ink:#1c1917; --ink2:#44403c; --muted:#78716c;
  --accent:#c2410c; --accent-strong:#9a3412; --accent-soft:#ffedd5; --accent-ink:#7c2d12;
  --border:#e7ddd0; --border2:#d6c9b8;
  --code-bg:#1c1917; --code-ink:#fde68a; --code-text:#e7e5e4;
  --success:#15803d; --success-bg:#dcfce7;
  --shadow:0 10px 30px rgba(28,25,23,.08);
  --radius:18px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0c0a09; --bg2:#1c1917; --surface:#1c1917; --surface2:#292524;
    --ink:#fafaf9; --ink2:#d6d3d1; --muted:#a8a29e;
    --accent:#fb923c; --accent-strong:#fdba74; --accent-soft:#431407; --accent-ink:#fed7aa;
    --border:#292524; --border2:#44403c;
    --code-bg:#000000; --code-ink:#fbbf24; --code-text:#e7e5e4;
    --success:#4ade80; --success-bg:#052e16;
    --shadow:0 10px 30px rgba(0,0,0,.35);
  }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Heebo",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;line-height:1.75;-webkit-font-smoothing:antialiased}
a{color:var(--accent-strong);text-decoration-thickness:1.5px;text-underline-offset:3px}
button{font:inherit;cursor:pointer}
code,pre,.mono{font-family:"JetBrains Mono",ui-monospace,monospace;direction:ltr;unicode-bidi:embed}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
/* HERO */
.hero{padding:42px 0 28px;background:radial-gradient(900px 420px at 85% -10%, var(--accent-soft), transparent 60%), linear-gradient(180deg,var(--bg2),var(--bg));border-bottom:1px solid var(--border)}
.hero-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.pill{display:inline-flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:6px 12px;font-size:.85rem;font-weight:600;color:var(--ink2)}
.pill b{color:var(--accent-strong)}
.hero h1{font-size:clamp(2.1rem,5.2vw,3.6rem);line-height:1.05;letter-spacing:-.02em;margin:0 0 14px;font-weight:900}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p.lead{font-size:clamp(1.05rem,2vw,1.3rem);color:var(--ink2);max-width:720px;margin:0 0 22px;line-height:1.6}
.hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
.meta-chip{background:var(--ink);color:var(--bg);padding:8px 14px;border-radius:999px;font-size:.9rem;font-weight:700}
.meta-chip.light{background:var(--surface);color:var(--ink);border:1px solid var(--border)}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:12px 20px;font-weight:800;border:1px solid transparent;text-decoration:none;font-size:1rem}
.btn-primary{background:var(--accent);color:#fff;box-shadow:var(--shadow)}
.btn-primary:hover{background:var(--accent-strong)}
.btn-ghost{background:var(--surface);color:var(--ink);border-color:var(--border2)}
.progress-card{margin-top:28px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 18px 16px;box-shadow:var(--shadow)}
.progress-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.progress-head strong{font-size:1rem}
.progress-head span{color:var(--muted);font-size:.9rem;font-weight:600}
.progress-bar{height:10px;background:var(--bg2);border-radius:999px;overflow:hidden;margin-top:10px;border:1px solid var(--border)}
.progress-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--accent),#ea580c);border-radius:999px;transition:width .4s ease}
.how{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:22px 0 6px}
.how-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px}
.how-card b{display:block;font-size:1.02rem;margin-bottom:4px}
.how-card p{margin:0;color:var(--ink2);font-size:.95rem;line-height:1.55}
/* LAYOUT */
.layout{display:grid;grid-template-columns:260px 1fr;gap:28px;align-items:start;padding:28px 0 60px}
.sidebar{position:sticky;top:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:16px;box-shadow:var(--shadow)}
.sidebar h3{margin:2px 0 10px;font-size:.95rem;letter-spacing:.02em}
.nav{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.nav a{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:10px;text-decoration:none;color:var(--ink2);font-weight:600;font-size:.94rem;line-height:1.35}
.nav a:hover,.nav a.active{background:var(--accent-soft);color:var(--accent-ink)}
.nav .n{flex:0 0 26px;height:26px;border-radius:999px;background:var(--bg2);border:1px solid var(--border);display:grid;place-items:center;font-size:.8rem;font-weight:800;color:var(--ink)}
.nav a.done .n{background:var(--success);color:#fff;border-color:var(--success)}
.sidebar .src{margin-top:14px;padding-top:12px;border-top:1px dashed var(--border2);font-size:.85rem;color:var(--muted);line-height:1.5}
main{min-width:0}
.chapter{background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:28px 26px;margin-bottom:22px;box-shadow:var(--shadow);scroll-margin-top:18px}
.chapter-head{display:flex;gap:16px;align-items:flex-start;margin-bottom:8px}
.num{flex:0 0 54px;height:54px;border-radius:16px;background:var(--ink);color:var(--bg);display:grid;place-items:center;font-size:1.5rem;font-weight:900}
.chapter h2{margin:0;font-size:clamp(1.45rem,2.6vw,1.9rem);line-height:1.2;letter-spacing:-.01em}
.chapter .sub{color:var(--accent-strong);font-weight:700;margin:2px 0 0}
.chapter p{color:var(--ink2);margin:10px 0}
.chapter p strong,.chapter li strong{color:var(--ink)}
.chapter ul,.chapter ol{color:var(--ink2);padding-inline-start:20px;margin:10px 0}
.chapter li{margin:6px 0}
.chapter h3{margin:22px 0 8px;font-size:1.12rem}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}
.mini{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:14px}
.mini b{display:block;margin-bottom:4px}
.mini p{margin:0;font-size:.94rem}
.callout{border-radius:14px;padding:14px 16px;margin:16px 0;border:1px solid var(--border);background:var(--bg2)}
.callout.warn{background:#fff7ed;border-color:#fed7aa}
@media (prefers-color-scheme: dark){.callout.warn{background:#431407;border-color:#7c2d12}}
.callout p{margin:0}
.prompt-box{background:var(--code-bg);color:var(--code-text);border-radius:16px;padding:0;overflow:hidden;margin:16px 0;border:1px solid #292524}
.prompt-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 14px;background:rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.1)}
.prompt-head span{font-size:.85rem;font-weight:700;color:#fdba74;letter-spacing:.02em}
.copy-btn{background:#fff;color:#1c1917;border:0;border-radius:999px;padding:7px 14px;font-weight:800;font-size:.88rem;display:inline-flex;gap:6px;align-items:center}
.copy-btn.copied{background:var(--success);color:#fff}
.prompt-body{padding:16px;white-space:pre-wrap;word-break:break-word;font-size:.96rem;line-height:1.7;direction:rtl;text-align:right}
.prompt-body.ltr{direction:ltr;text-align:left;font-family:"JetBrains Mono",monospace;font-size:.9rem;color:var(--code-ink)}
.table-wrap{margin:16px 0;border:1px solid var(--border);border-radius:14px;overflow:hidden}
table{width:100%;border-collapse:collapse;background:var(--surface)}
th,td{padding:12px 14px;text-align:right;vertical-align:top;border-bottom:1px solid var(--border);font-size:.96rem}
th{background:var(--bg2);font-weight:800;color:var(--ink)}
td{color:var(--ink2)}
tr:last-child td{border-bottom:0}
.done-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px dashed var(--border2)}
.done-btn{border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);border-radius:999px;padding:9px 18px;font-weight:800;display:inline-flex;gap:8px;align-items:center}
.done-btn.is-done{background:var(--success-bg);border-color:var(--success);color:var(--success)}
.done-hint{font-size:.88rem;color:var(--muted)}

/* Video clips */
.clips{display:grid;gap:12px;margin:18px 0 6px}
.clip{border-radius:16px;overflow:hidden;border:1px solid var(--border2);background:#1c1917}
.clip-poster{all:unset;box-sizing:border-box;cursor:pointer;width:100%;display:grid;grid-template-columns:168px minmax(0,1fr);align-items:stretch;background:#1c1917;color:#fafaf9;text-align:right}
.clip-poster:focus-visible{outline:3px solid var(--accent);outline-offset:-3px}
.clip-thumb{position:relative;min-height:96px;background:linear-gradient(135deg,#7c2d12,#c2410c)}
.clip-thumb::after{content:"";position:absolute;inset:0;background:rgba(12,10,9,.35)}
.clip-poster:hover .clip-thumb::after{background:rgba(12,10,9,.12)}
.play{position:absolute;z-index:1;inset:0;margin:auto;width:46px;height:46px;border-radius:50%;background:#ea580c;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 6px 20px rgba(234,88,12,.45)}
.clip-meta{padding:14px 18px;display:flex;flex-direction:column;justify-content:center;gap:4px;min-width:0}
.clip-kicker{font-size:.82rem;color:#fdba74;font-weight:600;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.clip-kicker .t{direction:ltr;color:#fde68a;font-weight:700;font-family:"JetBrains Mono",monospace}
.clip-title{font-size:1.02rem;font-weight:700;line-height:1.35}
.clip-frame{position:relative;aspect-ratio:16/9;width:100%}
.clip-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.clip-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 14px;background:#0c0a09;color:#d6d3d1;font-size:.86rem}
.clip-bar a{color:#fde68a;font-weight:700;text-decoration:none}
@media (max-width:640px){.clip-poster{grid-template-columns:1fr}.clip-thumb{min-height:0;aspect-ratio:16/7}}
/* Tips */
.tips-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.tip{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:14px 16px}
.tip b{color:var(--ink)}
.tip p{margin:4px 0 0;font-size:.95rem}
/* Glossary */
.search-box{display:flex;gap:10px;margin:14px 0}
.search-box input{flex:1;padding:12px 16px;border-radius:999px;border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);font:inherit;font-size:1rem}
.search-box input:focus{outline:2px solid var(--accent);outline-offset:1px}
.glossary{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.term{border:1px solid var(--border);border-radius:14px;background:var(--surface2);overflow:hidden}
.term button{width:100%;background:none;border:0;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;text-align:right;color:var(--ink)}
.term button b{font-size:1rem}
.term button span.en{font-size:.82rem;color:var(--muted);font-family:"JetBrains Mono",monospace;direction:ltr}
.term .def{display:none;padding:0 16px 14px;color:var(--ink2);font-size:.95rem;line-height:1.6}
.term.open .def{display:block}
.term.open{border-color:var(--accent)}
.term .chev{transition:transform .2s;color:var(--accent);font-weight:900}
.term.open .chev{transform:rotate(180deg)}
.level{display:inline-block;font-size:.78rem;font-weight:800;padding:3px 10px;border-radius:999px;vertical-align:middle}
.level.basic{background:var(--success-bg);color:var(--success)}
.level.adv{background:var(--accent-soft);color:var(--accent-ink)}
details.more{border:1px solid var(--border);border-radius:14px;background:var(--surface2);margin:14px 0;overflow:hidden}
details.more summary{cursor:pointer;padding:13px 16px;font-weight:800;color:var(--ink);list-style:none}
details.more summary::-webkit-details-marker{display:none}
details.more summary::after{content:"⌄";float:left;color:var(--accent);font-weight:900}
details.more[open ] summary::after{content:"⌃"}
details.more .more-body{padding:0 16px 14px;color:var(--ink2)}
details.more .more-body p{margin:6px 0}
.try{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;padding:14px 16px;margin:14px 0}
@media (prefers-color-scheme: dark){.try{background:#052e16;border-color:#14532d}}
.try b{color:var(--success)}
.faq-item{border:1px solid var(--border);border-radius:14px;background:var(--surface2);margin-bottom:10px;overflow:hidden}
.faq-item button{width:100%;background:none;border:0;padding:15px 16px;text-align:right;font-weight:800;color:var(--ink);display:flex;justify-content:space-between;gap:10px;align-items:center}
.faq-item .ans{display:none;padding:0 16px 15px;color:var(--ink2);line-height:1.65}
.faq-item.open .ans{display:block}
.faq-item.open{border-color:var(--accent)}
.filter-row{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}
.chip-btn{border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:.92rem}
.chip-btn.active{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.uc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:6px}
.uc{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:15px 16px}
.uc b{display:block;margin-bottom:4px}
.uc p{margin:0;font-size:.94rem}
.uc .tag{font-size:.78rem;font-weight:800;color:var(--accent-strong)}
.builder{background:var(--surface2);border:1px solid var(--border);border-radius:16px;padding:18px;margin:14px 0}
.builder label{display:block;font-weight:800;margin:12px 0 6px;font-size:.95rem}
.builder select,.builder input[type=text],.builder textarea{width:100%;padding:11px 13px;border-radius:10px;border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);font:inherit}
.builder-out{background:var(--code-bg);color:var(--code-text);border-radius:12px;padding:16px;white-space:pre-wrap;line-height:1.7;margin-top:14px;min-height:90px}
.cmd-search{width:100%;padding:12px 16px;border-radius:999px;border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);font:inherit;margin:12px 0}
.kbd{direction:ltr;display:inline-block;background:var(--bg2);border:1px solid var(--border2);border-bottom-width:2px;border-radius:6px;padding:1px 7px;font-family:"JetBrains Mono",monospace;font-size:.85em;font-weight:700;color:var(--ink)}
/* Roles explorer */
.role-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 6px}
.role-btn{border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);border-radius:14px;padding:11px 16px;font-weight:800;font-size:.98rem;text-align:right;line-height:1.3}
.role-btn small{display:block;font-weight:600;color:var(--muted);font-size:.8rem}
.role-btn.active{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.role-btn.active small{color:color-mix(in srgb, var(--bg) 75%, transparent)}
.role-panel{display:none}
.role-panel.active{display:block}
.role-intro{font-size:1.02rem}
.role-setup{background:var(--accent-soft);border:1px solid var(--border);border-radius:14px;padding:14px 16px;margin:14px 0}
.role-setup b{color:var(--accent-ink)}
.role-setup p{margin:4px 0 0;font-size:.95rem}
.role-uc{border:1px solid var(--border);border-radius:16px;background:var(--surface2);padding:18px;margin:14px 0}
.role-uc h4{margin:0 0 6px;font-size:1.08rem}
.role-uc p{margin:6px 0}
.role-uc .what{color:var(--ink2)}
.role-uc h5{margin:14px 0 4px;font-size:.95rem;color:var(--accent-strong)}
.role-uc ol{margin:4px 0 10px}
.role-uc .prompt-box{margin:10px 0 2px}
.role-uc .result{background:var(--success-bg);border-radius:10px;padding:10px 14px;font-size:.94rem;color:var(--ink2);margin-top:12px}
.role-uc .result b{color:var(--success)}
footer{padding:28px 0 44px;color:var(--muted);font-size:.92rem}
.final{background:var(--ink);color:var(--bg);border-radius:22px;padding:28px 26px;margin-bottom:22px}
.final h2{color:var(--bg);margin:0 0 8px}
.final p{color:color-mix(in srgb, var(--bg) 82%, transparent)}
.final a{color:#fdba74;font-weight:700}
/* Quiz */
.quiz-q{border:1px solid var(--border);border-radius:14px;background:var(--surface2);padding:16px;margin:0 0 12px}
.quiz-q b.q{display:block;margin-bottom:10px;font-size:1.02rem}
.quiz-opts{display:grid;gap:8px}
.quiz-opt{text-align:right;background:var(--surface);border:1.5px solid var(--border2);border-radius:10px;padding:10px 14px;font-weight:600;color:var(--ink2);width:100%}
.quiz-opt:hover{border-color:var(--accent)}
.quiz-opt.sel{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-ink)}
.quiz-opt.right{border-color:var(--success);background:var(--success-bg);color:var(--success)}
.quiz-opt.wrong{border-color:#dc2626;background:#fef2f2;color:#991b1b}
@media (prefers-color-scheme: dark){.quiz-opt.wrong{background:#450a0a;color:#fca5a5}}
.quiz-opt:disabled{cursor:default;opacity:.92}
.quiz-why{display:none;margin:10px 0 0;color:var(--ink2);font-size:.94rem}
.quiz-q.graded .quiz-why{display:block}
.quiz-score{font-weight:800;font-size:1.05rem;margin:12px 0 0}
/* Path checklist */
.checklist{list-style:none;padding:0;margin:12px 0}
.checklist li{padding:9px 14px 9px 14px;border:1px solid var(--border);border-radius:10px;background:var(--surface2);margin:0 0 8px;color:var(--ink2)}
.checklist li b{color:var(--ink)}
.checklist li::before{content:"▸ ";color:var(--accent);font-weight:900}
/* Back to top */
#toTop{position:fixed;bottom:18px;inset-inline-end:18px;z-index:50;width:48px;height:48px;border-radius:50%;border:1px solid var(--border2);background:var(--ink);color:var(--bg);font-size:1.15rem;font-weight:900;box-shadow:var(--shadow);display:none;align-items:center;justify-content:center}
#toTop.show{display:flex}
@media print{
  .sidebar,.hero-actions,.progress-card,.clips,.done-row,#toTop,.search-box,.filter-row,.cmd-search,.how,.role-tabs{display:none!important}
  .role-panel{display:block!important}
  body{background:#fff}
  .layout{grid-template-columns:1fr;padding:0}
  .chapter,.final{box-shadow:none;break-inside:avoid}
  .term .def,.faq-item .ans{display:block}
}
@media (max-width:900px){
  .layout{grid-template-columns:1fr}
  .sidebar{position:static;order:2}
  .how,.three{grid-template-columns:1fr}
  .tips-grid,.glossary,.uc-grid{grid-template-columns:1fr}
  .chapter{padding:22px 18px}
  /* tables stack */
  table,thead,tbody,tr,th,td{display:block;width:100%}
  thead{display:none}
  tr{border-bottom:1px solid var(--border);padding:8px 0}
  tr:last-child{border-bottom:0}
  td{border:0;padding:6px 14px}
  td:first-child{font-weight:800;color:var(--ink)}
}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*{transition:none!important}}
/* ===== App navigation: home hub + one chapter per screen ===== */
.appbar{position:sticky;top:0;z-index:80;background:var(--surface);border-bottom:1px solid var(--border);box-shadow:0 2px 14px rgba(28,25,23,.07)}
.appbar-in{max-width:1180px;margin:0 auto;padding:8px 20px;display:flex;align-items:center;gap:8px}
.ab-btn{border:1.5px solid var(--border2);background:var(--surface);color:var(--ink);border-radius:999px;padding:8px 14px;font-weight:800;font-size:.92rem;display:inline-flex;gap:6px;align-items:center;white-space:nowrap}
.ab-btn:hover{border-color:var(--accent);color:var(--accent-strong)}
.ab-btn:disabled{opacity:.35;cursor:default}
.ab-btn:disabled:hover{border-color:var(--border2);color:var(--ink)}
.ab-title{flex:1;text-align:center;font-weight:800;font-size:1rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 4px}
body[data-view="home"] .ab-home,body[data-view="home"] .ab-navbtn{display:none}
body[data-view="home"] .hero{display:block}
body[data-view="chapter"] .hero{display:none}
body[data-view="home"] .sidebar{display:none}

<script>
(function(){
  var done = {};
  var total = 10;
  function updateProgress(){
    var count = Object.keys(done).filter(function(k){return done[k]}).length;
    document.getElementById('progressText').textContent = count + ' מתוך ' + total + ' שלבים הושלמו';
    document.getElementById('progressFill').style.width = (count/total*100) + '%';
    document.querySelectorAll('#sideNav a[data-ch]').forEach(function(a){
      var ch = a.getAttribute('data-ch');
      a.classList.toggle('done', !!done[ch]);
      var n = a.querySelector('.n');
      if(n) n.textContent = done[ch] ? '✓' : ch;
    });
  }
  document.querySelectorAll('[data-done]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var ch = btn.getAttribute('data-done');
      done[ch] = !done[ch];
      btn.classList.toggle('is-done', done[ch]);
      btn.textContent = done[ch] ? '✓ סיימתי שלב ' + ch : '○ סיימתי שלב ' + ch;
      updateProgress();
    });
  });

  // Copy buttons
  document.querySelectorAll('[data-copy]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var box = btn.closest('.prompt-box');
      var body = box ? box.querySelector('.prompt-body') : null;
      if(!body) return;
      var text = body.innerText.trim();
      function ok(){
        var old = btn.textContent;
        btn.textContent = '✓ הועתק';
        btn.classList.add('copied');
        setTimeout(function(){ btn.textContent = old; btn.classList.remove('copied'); }, 1800);
      }
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(ok).catch(function(){ fallback(); });
      } else { fallback(); }
      function fallback(){
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
        document.body.appendChild(ta); ta.select();
        try{ document.execCommand('copy'); ok(); }catch(e){}
        document.body.removeChild(ta);
      }
    });
  });


  // Video clips: light poster first, YouTube player only on click
  function fmt(sec){ return Math.floor(sec/60) + ':' + String(sec%60).padStart(2,'0'); }
  document.querySelectorAll('.clip').forEach(function(el){
    var v = el.getAttribute('data-v'), len = +el.getAttribute('data-len'), title = el.getAttribute('data-title');
    var poster = document.createElement('button');
    poster.type = 'button'; poster.className = 'clip-poster';
    poster.setAttribute('aria-label', 'נגן סרטון: ' + title);
    poster.innerHTML = '<span class="clip-thumb"><span class="play">▶</span></span>' +
      '<span class="clip-meta"><span class="clip-kicker"><span>סרטון הדגמה</span><span class="t">' + fmt(len) + '</span></span>' +
      '<span class="clip-title">' + title + '</span></span>';
    poster.addEventListener('click', function(){
      el.innerHTML = '<div class="clip-frame"><iframe src="https://www.youtube-nocookie.com/embed/' + v + '?autoplay=1&rel=0&modestbranding=1" title="' + title + '" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>' +
        '<div class="clip-bar"><span>' + title + '</span><a href="https://www.youtube.com/watch?v=' + v + '" target="_blank" rel="noopener">לצפייה ב־YouTube ↗</a></div>';
    });
    el.appendChild(poster);
  });

  // Glossary toggle + search
  document.querySelectorAll('.term > button').forEach(function(b){
    b.addEventListener('click', function(){ b.parentElement.classList.toggle('open'); });
  });
  var search = document.getElementById('glossSearch');
  search.addEventListener('input', function(){
    var q = search.value.trim().toLowerCase();
    var visible = 0;
    document.querySelectorAll('#glossaryGrid .term').forEach(function(t){
      var match = !q || t.textContent.toLowerCase().indexOf(q) !== -1;
      t.style.display = match ? '' : 'none';
      if(match) visible++;
    });
    document.getElementById('noResults').style.display = visible ? 'none' : 'block';
  });

  // Active nav on scroll
  var links = {};
  document.querySelectorAll('#sideNav a').forEach(function(a){ links[a.getAttribute('href').slice(1)] = a; });
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        document.querySelectorAll('#sideNav a').forEach(function(a){a.classList.remove('active')});
        var a = links[e.target.id]; if(a) a.classList.add('active');
      }
    });
  }, {rootMargin:'-20% 0px -70% 0px'});
  document.querySelectorAll('.chapter').forEach(function(s){ obs.observe(s); });

  // Use-case filter
  document.querySelectorAll('[data-filter]').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('[data-filter]').forEach(function(b){b.classList.remove('active')});
      btn.classList.add('active');
      var f = btn.getAttribute('data-filter');
      document.querySelectorAll('#ucGrid .uc').forEach(function(card){
        card.style.display = (f==='all' || card.getAttribute('data-cat')===f) ? '' : 'none';
      });
    });
  });

  // Roles explorer tabs
  document.querySelectorAll('.role-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.role-btn').forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-selected','true');
      var role = btn.getAttribute('data-role');
      document.querySelectorAll('.role-panel').forEach(function(p){
        p.classList.toggle('active', p.getAttribute('data-role-panel') === role);
      });
    });
  });

  // Commands search
  var cmdSearch = document.getElementById('cmdSearch');
  if(cmdSearch){
    cmdSearch.addEventListener('input', function(){
      var q = cmdSearch.value.trim().toLowerCase(); var vis = 0;
      document.querySelectorAll('.cmd-table tbody tr').forEach(function(tr){
        var m = !q || tr.textContent.toLowerCase().indexOf(q) !== -1;
        tr.style.display = m ? '' : 'none'; if(m) vis++;
      });
      document.getElementById('cmdNoResults').style.display = vis ? 'none' : 'block';
    });
  }

  // FAQ accordion
  document.querySelectorAll('.faq-item > button').forEach(function(b){
    b.addEventListener('click', function(){ b.parentElement.classList.toggle('open'); });
  });

  // Prompt lab
  var pbPlanOn = false;
  function pbBuild(){
    var task = document.getElementById('pbTask').value;
    var ctx = document.getElementById('pbContext').value.trim();
    var fmt = document.getElementById('pbFormat').value;
    var tone = document.getElementById('pbTone').value;
    var extra = document.getElementById('pbExtra').value.trim();
    var out = task + '.';
    if(ctx) out += '\nהקשר: ' + ctx + '.';
    out += '\nפורמט: הצג את התוצאה ' + fmt + '.';
    out += '\nסגנון: ' + tone + '.';
    if(extra) out += '\nחשוב: ' + extra + '.';
    if(pbPlanOn) out += '\nלפני שאתה מתחיל: עבור למצב Plan — שאל אותי שאלות הבהרה, הצג תוכנית, וחכה לאישור שלי.';
    document.getElementById('pbOut').textContent = out;
  }
  ['pbTask','pbContext','pbFormat','pbTone','pbExtra'].forEach(function(id){
    var el = document.getElementById(id);
    if(el){ el.addEventListener('input', pbBuild); el.addEventListener('change', pbBuild); }
  });
  var pbPlanBtn = document.getElementById('pbPlan');
  if(pbPlanBtn){ pbPlanBtn.addEventListener('click', function(){
    pbPlanOn = !pbPlanOn;
    pbPlanBtn.textContent = pbPlanOn ? '✓ נוסף “מצב Plan” — לחצו להסרה' : '+ הוסף “התחל במצב Plan”';
    pbBuild();
  }); }
  var pbCopyBtn = document.getElementById('pbCopy');
  if(pbCopyBtn){ pbCopyBtn.addEventListener('click', function(){
    var t = document.getElementById('pbOut').textContent;
    function ok(){ var o = pbCopyBtn.textContent; pbCopyBtn.textContent = '✓ הועתק — הדביקו ב־Claude'; setTimeout(function(){ pbCopyBtn.textContent = o; }, 2000); }
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(t).then(ok).catch(function(){}); }
  }); }
  if(document.getElementById('pbOut')) pbBuild();

  // Self-test quiz
  var QUIZ = [
    {q:'מה ההבדל המרכזי בין Claude Code לצ׳אט רגיל?', opts:['הוא עונה מהר יותר','הוא עובד על הקבצים במחשב שלכם — קורא, יוצר ומשנה','הוא יודע רק עברית','אין הבדל, זה אותו ממשק'], a:1, why:'נכון — Claude Code פועל בתוך תיקיית עבודה על המחשב ומבצע משימות מקצה לקצה (פרק 1).'},
    {q:'אילו קבצים Claude רואה בשיחה?', opts:['את כל המחשב','רק קבצים ששלחו לו במייל','רק את תיקיית העבודה של השיחה ומה שחיברתם במפורש','רק מסמכי Word'], a:2, why:'בדיוק. מה שמחוץ לתיקיית העבודה לא נגיש — ולכן עובדים בתיקייה נפרדת לכל פרויקט (פרק 3).'},
    {q:'מתי CLAUDE.md נכנס לתוקף?', opts:['מיד כששומרים אותו, גם באמצע שיחה','בתחילת כל שיחה חדשה','פעם ביום','רק אחרי הפעלה מחדש של המחשב'], a:1, why:'הקובץ נטען בתחילת שיחה. שיניתם הוראות? פותחים שיחה חדשה (פרק 4).'},
    {q:'מה עושה מצב Plan?', opts:['מוחק קבצים ישנים','חוקר ומציג תוכנית לאישור — בלי לשנות כלום','מאיץ את המודל','מתרגם את השיחה לאנגלית'], a:1, why:'Plan הוא מצב החקירה והתכנון: שאלות, תוכנית, אישור — ורק אז ביצוע (פרק 5).'},
    {q:'מה ההבדל בין סקיל לסוכן?', opts:['אין הבדל','סקיל הוא מתכון למשימה; סוכן הוא מבצע עצמאי עם הקשר משלו שיכול להשתמש בכמה סקילים','סוכן הוא סקיל בתשלום','סקיל עובד רק באנגלית'], a:1, why:'מתכון מול עובד — כלל האצבע של פרקים 6–7.'},
    {q:'יצרתם סקיל חדש, אבל Claude לא משתמש בו. מה הסיבה הסבירה?', opts:['הסקיל פגום תמיד','צריך לשלם','סקילים נטענים בתחילת שיחה — צריך לפתוח שיחה חדשה','צריך להחליף מודל'], a:2, why:'כמו CLAUDE.md — טעינה בתחילת שיחה בלבד (פרק 6).'},
    {q:'איך Claude מתחבר לכלים כמו Gmail, Excel או Canva?', opts:['הוא לא יכול','רק דרך צילומי מסך','דרך Connectors רשמיים או MCP — תקן חיבור פתוח','רק מפתחים יכולים'], a:2, why:'שתי דרכים, אותו רעיון: חיבור רשמי או MCP — “כמו USB-C לכלים” (פרק 9).'},
    {q:'שיחה ארוכה, התשובות נחלשות וההקשר מתמלא. מה עושים?', opts:['ממשיכים בכל זאת','‎/compact לדחיסה, או /clear לשיחה נקייה עם סיכום קצר','מוחקים את התיקייה','מחכים יום'], a:1, why:'ניהול הקשר הוא מיומנות בסיס: /context לבדיקה, /compact או /clear לטיפול (פרקים 5 ו־“הפקודות החשובות”).'}
  ];
  var quizBox = document.getElementById('quizBox');
  var quizSel = [];
  if(quizBox){
    QUIZ.forEach(function(item, qi){
      var wrap = document.createElement('div'); wrap.className = 'quiz-q';
      var html = '<b class="q">' + (qi+1) + '. ' + item.q + '</b><div class="quiz-opts">';
      item.opts.forEach(function(opt, oi){ html += '<button type="button" class="quiz-opt" data-q="' + qi + '" data-o="' + oi + '">' + opt + '</button>'; });
      html += '</div><p class="quiz-why">' + item.why + '</p>';
      wrap.innerHTML = html;
      quizBox.appendChild(wrap);
    });
    quizBox.addEventListener('click', function(e){
      var b = e.target.closest ? e.target.closest('.quiz-opt') : null;
      if(!b || b.disabled) return;
      var qi = +b.getAttribute('data-q');
      quizSel[qi] = +b.getAttribute('data-o');
      quizBox.querySelectorAll('.quiz-opt[data-q="' + qi + '"]').forEach(function(o){ o.classList.toggle('sel', o === b); });
    });
    var quizCheck = document.getElementById('quizCheck');
    var quizReset = document.getElementById('quizReset');
    var quizScore = document.getElementById('quizScore');
    quizCheck.addEventListener('click', function(){
      var score = 0, answered = 0;
      QUIZ.forEach(function(item, qi){
        var wrap = quizBox.children[qi];
        wrap.classList.add('graded');
        wrap.querySelectorAll('.quiz-opt').forEach(function(o){
          var oi = +o.getAttribute('data-o');
          o.disabled = true;
          o.classList.remove('sel');
          if(oi === item.a) o.classList.add('right');
          else if(quizSel[qi] === oi) o.classList.add('wrong');
        });
        if(quizSel[qi] != null) answered++;
        if(quizSel[qi] === item.a) score++;
      });
      var msg = 'הציון: ' + score + ' מתוך ' + QUIZ.length + '. ';
      if(answered < QUIZ.length) msg += 'שימו לב: לא עניתם על כל השאלות. ';
      msg += score === QUIZ.length ? 'מושלם — אתם שולטים בחומר 🎉' : (score >= 6 ? 'יפה מאוד! עברו על ההסברים ליד השאלות שפספסתם.' : 'לא נורא — ההסברים ליד כל שאלה מפנים בדיוק לפרק הנכון. עברו עליהם ונסו שוב.');
      quizScore.textContent = msg;
      quizCheck.disabled = true;
    });
    quizReset.addEventListener('click', function(){
      quizSel = [];
      quizScore.textContent = '';
      quizCheck.disabled = false;
      Array.prototype.forEach.call(quizBox.children, function(wrap){
        wrap.classList.remove('graded');
        wrap.querySelectorAll('.quiz-opt').forEach(function(o){ o.disabled = false; o.classList.remove('sel','right','wrong'); });
      });
    });
  }

  // ===== App router: home hub + one chapter per screen =====
  var ORDER = [];
  document.querySelectorAll('#sideNav a').forEach(function(a){
    var id = a.getAttribute('href').slice(1);
    var title = '';
    a.childNodes.forEach(function(n){ if(n.nodeType === 3) title += n.textContent; });
    ORDER.push({id:id, title:title.trim()});
  });
  ORDER.push({id:'final', title:'סיום — הצעדים הבאים'});
  var orderIds = ORDER.map(function(o){ return o.id; });
  var currentId = null;
  var abTitle = document.getElementById('abTitle');
  var abPrev = document.getElementById('abPrev');
  var abNext = document.getElementById('abNext');

  function setHash(id){
    try{
      if(id) history.replaceState(null, '', '#' + id);
      else history.replaceState(null, '', location.pathname + location.search);
    }catch(e){}
  }
  function goHome(){
    currentId = null;
    document.body.setAttribute('data-view', 'home');
    document.body.classList.remove('nav-open');
    document.querySelectorAll('main .chapter, main .final').forEach(function(s){ s.classList.remove('active'); });
    document.querySelectorAll('#sideNav a').forEach(function(a){ a.classList.remove('active'); });
    abTitle.textContent = 'בית המדריך';
    setHash(null);
    window.scrollTo(0, 0);
  }
  function go(id){
    var sec = document.getElementById(id);
    if(!sec || orderIds.indexOf(id) === -1){ goHome(); return; }
    currentId = id;
    document.body.setAttribute('data-view', 'chapter');
    document.body.classList.remove('nav-open');
    document.querySelectorAll('main .chapter, main .final').forEach(function(s){ s.classList.toggle('active', s === sec); });
    var idx = orderIds.indexOf(id);
    abTitle.textContent = ORDER[idx].title;
    abPrev.disabled = idx <= 0;
    abNext.disabled = idx >= ORDER.length - 1;
    document.querySelectorAll('#sideNav a').forEach(function(a){
      a.classList.toggle('active', a.getAttribute('href') === '#' + id);
    });
    setHash(id);
    window.scrollTo(0, 0);
  }
  function step(dir){
    if(!currentId) return;
    var idx = orderIds.indexOf(currentId) + dir;
    if(idx >= 0 && idx < ORDER.length) go(ORDER[idx].id);
  }
  if(abPrev) abPrev.addEventListener('click', function(){ step(-1); });
  if(abNext) abNext.addEventListener('click', function(){ step(1); });
  var abHome = document.getElementById('abHome');
  if(abHome) abHome.addEventListener('click', goHome);
  var abMenu = document.getElementById('abMenu');
  if(abMenu) abMenu.addEventListener('click', function(){ document.body.classList.toggle('nav-open'); });

  // Bottom prev/next + home buttons inside every chapter
  ORDER.forEach(function(item, idx){
    var sec = document.getElementById(item.id);
    if(!sec) return;
    var nav = document.createElement('div');
    nav.className = 'ch-nav';
    var html = '';
    if(idx > 0) html += '<button type="button" data-goto="' + ORDER[idx-1].id + '"><small>הפרק הקודם</small>' + ORDER[idx-1].title + '</button>';
    html += '<button type="button" class="home-btn" data-goto="__home">⌂ בית המדריך</button>';
    if(idx < ORDER.length - 1) html += '<button type="button" data-goto="' + ORDER[idx+1].id + '"><small>הפרק הבא</small>' + ORDER[idx+1].title + '</button>';
    nav.innerHTML = html;
    sec.appendChild(nav);
  });
  document.querySelectorAll('.ch-nav button').forEach(function(b){
    b.addEventListener('click', function(){
      var t = b.getAttribute('data-goto');
      if(t === '__home') goHome(); else go(t);
    });
  });

  // Hub cards: whole card navigates, inner links jump straight to a chapter
  document.querySelectorAll('.hub-card').forEach(function(card){
    function open(){ go(card.getAttribute('data-goto')); }
    card.addEventListener('click', function(e){
      if(e.target.closest && e.target.closest('a')) return;
      open();
    });
    card.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); open(); }
    });
  });

  // All in-page anchor links route between screens instead of scrolling
  document.addEventListener('click', function(e){
    var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
    if(!a) return;
    var id = a.getAttribute('href').slice(1);
    if(!id) return;
    if(orderIds.indexOf(id) !== -1){ e.preventDefault(); go(id); }
  });
  window.addEventListener('hashchange', function(){
    var id = location.hash.slice(1);
    if(id && orderIds.indexOf(id) !== -1 && id !== currentId) go(id);
    if(!id && currentId) goHome();
  });
  // Deep link on load: #ch5 opens chapter 5 directly
  (function(){
    var id = location.hash.slice(1);
    if(id && orderIds.indexOf(id) !== -1) go(id); else goHome();
  })();

  // Back to top
  var toTop = document.getElementById('toTop');
  if(toTop){
    window.addEventListener('scroll', function(){ toTop.classList.toggle('show', window.scrollY > 700); }, {passive:true});
    toTop.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
  }

  updateProgress();
})();
</script>
</body>
</html>

rules_version = '2';
// חוקי אבטחה ל-Firestore של "מרכזי הלמידה" (13/11/2026).
// מדביקים ב-Firebase Console: Firestore -> Rules -> Publish.
// כל משפחה שמורה תחת families/{fid}, כש-fid הוא SHA-256 של קוד המשפחה (64 תווים).
// מי שלא יודע את הקוד לא יכול לנחש את fid ולא יכול לרשום את רשימת המשפחות.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{fid}/keys/{key} {
      allow get, list: if request.auth != null && fid.size() == 64;
      allow delete: if request.auth != null && fid.size() == 64;
      allow create, update: if request.auth != null && fid.size() == 64
        && request.resource.data.keys().hasOnly(['v', 't'])
        && request.resource.data.v is string
        && request.resource.data.v.size() < 900000
        && request.resource.data.t is int;
    }
    // כל השאר סגור
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
